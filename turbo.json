{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ACCOUNT_API_BASE_URL",
    "AI_PROXY_TOKEN_NAME",
    "API_URL",
    "AP_USER_DOMAIN",
    "AP_USER_DOMAIN_TLS_SECRET_NAME",
    "BRAIN_V1_IMPORT_RETRIES",
    "BRAIN_V1_IMPORT_YES",
    "CODEX_GATEWAY_MODEL",
    "CODEX_GATEWAY_OPENAI_API_KEY",
    "CODEX_GATEWAY_OPENAI_BASE_URL",
    "DATABASE_URL",
    "DEVBOX_API_BASE_URL",
    "DEVBOX_TOKEN",
    "DEV_APP_TOKEN_USER_UID",
    "DEV_OPENAI_API_BASE_URL",
    "DEV_OPENAI_API_KEY",
    "DEPLOY_DEVBOX_STORAGE_LIMIT",
    "DIRECT_AP_READINESS_TIMEOUT_MS",
    "FREE_CHAT_TURNS",
    "GTM_ID",
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_OAUTH_CLIENT_ID",
    "GITHUB_OAUTH_CLIENT_SECRET",
    "GITHUB_USER_TOKEN_ENCRYPTION_KEY",
    "GLASS_E2E_REPEATS",
    "GLASS_E2E_TRACE",
    "GLASS_E2E_URL",
    "KUBERNETES_SERVICE_HOST",
    "KUBERNETES_SERVICE_PORT",
    "NEXT_DIST_DIR",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "SEALOS_CERT_SECRET",
    "SEALOS_CERT_SECRET_NAME",
    "SYSTEM_OPENAI_API_BASE_URL",
    "SYSTEM_OPENAI_API_KEY",
    "TEMPLATE_PROVIDER_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "env": ["REACT_SCAN"],
      "persistent": true
    }
  }
}
