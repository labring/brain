API_URL=
NEXT_PUBLIC_DEV_ENCODED_KUBECONFIG=
# Optional canonical app origin for GitHub App install callbacks. Leave empty
# to derive it from request headers at runtime.
APP_URL=
# Optional runtime Google Tag Manager container id, for example GTM-XXXXXXX.
GTM_ID=

# Defaults for Brain-created AP platform Ingresses. Deployed environments get
# these from apPublicAccess.userDomains[0] in the brain-system chart.
AP_USER_DOMAIN=
AP_USER_DOMAIN_TLS_SECRET_NAME=wildcard-cert

DATABASE_URL=
MARKETING_EVENTS_INGEST_SECRET=
# Shared HS256 secret for Desktop-issued marketing consent receipts.
MARKETING_CONSENT_SIGNING_KEY=

# Account-service upstream for Billing Area routes. The Helm chart derives the
# in-cluster Service URL when its value is empty; local development must set an
# explicit reachable URL.
ACCOUNT_API_BASE_URL=

# Cluster-level Billing Area display currency. Defaults to usd.
BILLING_CURRENCY=usd

# The region domain this deployment belongs to (account-service's
# LocalRegionDomain). The regions route verifies it against the platform's
# region list and marks the Current Region; billing refuses to render when it
# is missing or unknown. Not needed while the billing dev-mock answers.
BILLING_LOCAL_REGION_DOMAIN=

# Show GPU quota and pricing rows on GPU-enabled clusters. Defaults to false.
BILLING_GPU_ENABLED=false

# App-token verification for personal-resource routes (ADR-0059). Required in
# production (startup fails fast without it). For local dev pick any secret,
# then mint a matching token for the dev kubeconfig with
#   bun scripts/mint-dev-app-token.mjs
# and paste it into NEXT_PUBLIC_DEV_APP_TOKEN.
JWT_INTERNAL=
NEXT_PUBLIC_DEV_APP_TOKEN=

SYSTEM_OPENAI_API_KEY=
SYSTEM_OPENAI_API_BASE_URL=https://api.openai.com/v1
DEV_OPENAI_API_KEY=
DEV_OPENAI_API_BASE_URL=
FREE_CHAT_TURNS=5

DEVBOX_API_BASE_URL=
TEMPLATE_PROVIDER_URL=

DEVBOX_JWT_SIGNING_KEY=
DEVBOX_RUNTIME_IMAGE=ghcr.io/labring-actions/devbox-base-images/sandbox-v1:2026-6-stable-zh-cn-amd64
DEVBOX_JWT_TTL_SECONDS=14400
# Skill repository source installed into Chat Agent and AI deployment Devboxes.
DEPLOY_SKILL_SOURCE=
# Public Streamable HTTP endpoint reachable from deployment Devboxes.
DEPLOY_AGENT_MCP_URL=https://brain.example.com/api/deploy-agent/mcp/v1
# Optional comma-separated browser Origin allowlist. Codex MCP clients do not
# send Origin and are authenticated by a task-scoped Bearer capability.
DEPLOY_AGENT_MCP_ALLOWED_ORIGINS=

# Optional. When both are set, GitHub Deploy uses this OpenAI-compatible
# endpoint instead of the caller's AI Proxy. Leave empty to reuse
# CODEX_GATEWAY_OPENAI_* then SYSTEM_OPENAI_* when that pair is complete.
GITHUB_DEPLOY_OPENAI_API_KEY=
GITHUB_DEPLOY_OPENAI_BASE_URL=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_USER_TOKEN_ENCRYPTION_KEY=

# Local development only.
NODE_TLS_REJECT_UNAUTHORIZED=
