API_URL=
NEXT_PUBLIC_DEV_ENCODED_KUBECONFIG=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Defaults for Brain-created AP platform Ingresses. Deployed environments get
# these from apPublicAccess.userDomains[0] in the brain-system chart.
AP_USER_DOMAIN=
AP_USER_DOMAIN_TLS_SECRET_NAME=wildcard-cert

DATABASE_URL=

# App-token verification for personal-resource routes (ADR-0059). Required in
# production (startup fails fast without it). For local dev pick any secret,
# then mint a matching token for the dev kubeconfig with
#   bun scripts/mint-dev-app-token.mjs
# and paste it into NEXT_PUBLIC_DEV_APP_TOKEN.
JWT_INTERNAL=
NEXT_PUBLIC_DEV_APP_TOKEN=

SYSTEM_OPENAI_API_KEY=
SYSTEM_OPENAI_API_BASE_URL=https://api.openai.com/v1
DEV_OPENAI_API_KEY=
DEV_OPENAI_API_BASE_URL=
FREE_CHAT_TURNS=5

DEVBOX_API_BASE_URL=
TEMPLATE_PROVIDER_URL=

DEVBOX_JWT_SIGNING_KEY=
DEVBOX_RUNTIME_IMAGE=ghcr.io/labring-actions/devbox-base-images/sandbox-v1:2026-6-stable-zh-cn-amd64
DEVBOX_ARCHIVE_AFTER_PAUSE_TIME=24h
DEVBOX_JWT_TTL_SECONDS=14400
# Optional. Defaults to the production brain-deploy skill source.
DEPLOY_SKILL_SOURCE=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_USER_TOKEN_ENCRYPTION_KEY=

# Local development only.
NODE_TLS_REJECT_UNAUTHORIZED=
