DATABASE_URL=

# Off-cluster/local development only. In a Pod, Kubernetes-injected
# KUBERNETES_SERVICE_HOST/PORT take precedence and keep traffic on the internal endpoint.
K8S_API_URL=
# PEM CA bundle for K8S_API_URL, or for Pods without a mounted service-account CA.
K8S_API_CA=

DB_PUBLIC_HOST=
WHODB_URL=

VMSELECT_URL=http://127.0.0.1:8481/select/0/prometheus/api/v1/query
VLSELECT_URL=http://127.0.0.1:8482/select/logsql/query

# Optional VictoriaLogs/VMAUTH credentials.
VLSELECT_USERNAME=
VLSELECT_PASSWORD=
VMAUTH_SECRET_NAMESPACE=
VMAUTH_SECRET_NAME=
